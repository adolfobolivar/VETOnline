# Dev environment config for the frontend. Not secrets — a Cognito user pool/app client id and
# an API Gateway URL are necessarily embedded in the public JS bundle shipped to browsers
# (unlike terraform/environments/*/secrets.yaml's AWS credentials), so this is committed,
# mirroring input.yaml's "environment-specific but non-secret" pattern rather than gitignored.
# Values are terraform/environments/dev's cognito_user_pool_id / cognito_user_pool_client_id /
# api_invoke_url / aws_region outputs.
VITE_API_BASE_URL=https://6g0xc3fiqf.execute-api.us-east-1.amazonaws.com/dev
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_FtvMEkbb2
VITE_COGNITO_USER_POOL_CLIENT_ID=3la96s1e1ja7dcdbpdo6gverku
