# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / frontend
node_modules/
dist/
build/
.vite/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform per-account secrets (AWS credentials) — never commit, input.yaml is fine.
# One file per account, shared by that account's environments/ and bootstrap/ modules.
terraform/environments/*/secrets.yaml

# Clinic User roster (UC-011) — real staff names/personal emails (PII), never commit.
# clinic_users.yaml.example (committed) documents the schema with placeholder values.
terraform/environments/*/clinic_users.yaml

# Lambda packaging build artifacts (zip + cross-platform installed dependencies) — rebuilt by
# build_lambda.sh on every apply, never committed.
terraform/modules/application/.build/

# Editors
.vscode/
.idea/
